# API Configuration
# L'API est accessible via nginx sur le port 8080 (pas directement sur 3000)

# Pour appareil physique connecté au même réseau WiFi :
EXPO_PUBLIC_API_URL=http://192.168.10.166:8080/api

# Pour émulateur Android : utilisez 10.0.2.2
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# Pour iOS Simulator sur Mac :
# EXPO_PUBLIC_API_URL=http://localhost:8080/api
